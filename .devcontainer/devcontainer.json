{
  "name": "IXO - Agente de Apuestas",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },
  "remoteEnv": {
    "GROQ_API_KEY": "${localEnv:GROQ_API_KEY}",
    "ODDS_API_KEY": "${localEnv:ODDS_API_KEY}",
    "API_SPORTS_KEY": "${localEnv:API_SPORTS_KEY}",
    "RAPIDAPI_KEY": "${localEnv:RAPIDAPI_KEY}",
    "LOCAL_TZ": "America/Bogota"
  }
}
